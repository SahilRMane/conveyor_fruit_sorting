<?xml version="1.0"?>
<robot name="panda" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find moveit_resources_panda_description)/urdf/panda.urdf.xacro"/>

  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="enable_wrist_ft" default="false"/>
  <xacro:arg name="mujoco_model"
             default="$(find sorting_description)/mujoco/franka_emika_panda/scene.xml"/>

  <link name="world"/>
  <joint name="world_to_panda" type="fixed">
    <parent link="world"/>
    <child link="panda_link0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="controlled_joint"
               params="name initial lower upper">
    <joint name="${name}">
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="PandaMujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <param name="headless">$(arg headless)</param>
    </hardware>

    <!-- Initial positions match the prepared MJCF home keyframe. -->
    <xacro:controlled_joint name="panda_joint1"
        initial="0.0" lower="-2.8973" upper="2.8973"/>
    <xacro:controlled_joint name="panda_joint2"
        initial="0.0" lower="-1.7628" upper="1.7628"/>
    <xacro:controlled_joint name="panda_joint3"
        initial="0.0" lower="-2.8973" upper="2.8973"/>
    <xacro:controlled_joint name="panda_joint4"
        initial="-1.57079" lower="-3.0718" upper="-0.0698"/>
    <xacro:controlled_joint name="panda_joint5"
        initial="0.0" lower="-2.8973" upper="2.8973"/>
    <xacro:controlled_joint name="panda_joint6"
        initial="1.57079" lower="-0.0175" upper="3.7525"/>
    <xacro:controlled_joint name="panda_joint7"
        initial="-0.7853" lower="-2.8973" upper="2.8973"/>

    <xacro:controlled_joint name="panda_finger_joint1"
        initial="0.04" lower="0.0" upper="0.04"/>

    <!-- MuJoCo supplies the physical coupling between the fingers.
         Read the second finger. Do not command it separately. -->
    <joint name="panda_finger_joint2" mimic="false">
      <state_interface name="position">
        <param name="initial_value">0.04</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
    <xacro:if value="$(arg enable_wrist_ft)">
      <sensor name="panda_hand_wrench_fts">
        <!-- Select the driver mapping and the MJCF sensor base name. -->
        <param name="mujoco_type">fts</param>
        <param name="mujoco_sensor_name">panda_hand_wrench</param>
        <state_interface name="force.x"/><state_interface name="force.y"/><state_interface name="force.z"/>
        <state_interface name="torque.x"/><state_interface name="torque.y"/><state_interface name="torque.z"/>
        <param name="frame_id">panda_hand</param>
      </sensor>
    </xacro:if>
  </ros2_control>
</robot>
